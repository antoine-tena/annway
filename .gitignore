# --- Secrets: only the example without real values is tracked ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Claude Code: what stays on each machine (settings.json, skills/, rules/, hooks/ and
# plans/ are shared) ---
.claude/settings.local.json
.claude/worktrees/
.claude/memory/
.claude/sessions/
# Link to the installed kiln plugin, made by kiln 0.3's session hook.
.claude/kiln
# Serena's index (plugin serena@kiln), specific to each worktree.
.serena/
CLAUDE.local.md

# --- Logs ---
*.log
logs/

# --- Editors ---
.idea/
*.swp

# --- System ---
.DS_Store
Thumbs.db
*:Zone.Identifier

# --- Java (backend): Maven and JVM output, key stores ---
backend/target/
*.class
hs_err_pid*.log
replay_pid*.log
*.jks
*.keystore
# Java IDE projects (IntelliJ, Eclipse): specific to each machine.
*.iml
.classpath
.project
.settings/
.factorypath
