# Fins de ligne normalisées en LF dans le dépôt, quel que soit le poste (Windows compris).
* text=auto eol=lf
# Scripts Windows du wrapper Maven : fins de ligne CRLF, que cmd.exe attend.
*.cmd text eol=crlf

# Binaires.
*.png binary
*.jpg binary
*.ico binary
*.npz binary

